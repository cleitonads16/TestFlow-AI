# Copie para docker/.env e preencha. O docker/.env nunca é versionado.

# Django
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL (o usuário e o banco são criados na primeira subida do container)
MYSQL_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-senha-tambem

# Provedor de IA. Sem ela, a geração de casos responde 503; o resto da API funciona.
ANTHROPIC_API_KEY=
