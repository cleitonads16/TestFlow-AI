# Copie para docker/.env e preencha. O docker/.env nunca é versionado.

# Django
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL (o usuário e o banco são criados na primeira subida do container)
MYSQL_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-senha-tambem

# Provedor de IA ativo: claude ou openai (só ferramentas homologadas na ComBio,
# com chave de conta corporativa).
LLM_PROVIDER=claude
# Modelo da OpenAI (opcional; padrão gpt-5.5).
OPENAI_MODEL=

# CAMINHO do arquivo com cada chave, nunca a chave em si. Os arquivos precisam
# ficar fora do repositório (ex.: C:/pessoal/...). Sem a chave do provedor
# ativo, só a geração de casos responde 503; o resto da API funciona.
ANTHROPIC_API_KEY_ARQUIVO=C:/caminho/fora/do/repositorio/apikey_claude.txt
OPENAI_API_KEY_ARQUIVO=C:/caminho/fora/do/repositorio/api-key-openai.txt
